# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=https://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/customer_payment_portal

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
SALT_ROUNDS=12

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
PAYMENT_RATE_LIMIT_MAX=10

# Session Configuration
SESSION_TIMEOUT=1800000

# Logging
LOG_LEVEL=info

# Password Pepper (extra secret for password hashing)
PASSWORD_PEPPER=your-super-secret-pepper-value-change-this-to-random-string-min-32-chars
